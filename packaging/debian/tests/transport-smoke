#!/bin/sh
# Run upstream's transport harness against the installed /usr/bin/supersonic.
# The harness builds its OSC probe client with cargo, with no network: from
# the rust-vendor component where the source package carries one, and from the
# archive's crate packages where it was assembled to build against those
# (debian/build-mode.mk; the test then depends on the build dependencies).
set -eu

if [ -d rust-vendor ]; then
    crates="$(pwd)/rust-vendor"
else
    crates=/usr/share/cargo/registry
fi

export CARGO_HOME="${AUTOPKGTEST_TMP:-/tmp}/cargo-home"
mkdir -p "$CARGO_HOME"
cat > "$CARGO_HOME/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "$crates"
EOF
export CARGO_NET_OFFLINE=true

exec test/transport-harness/run.sh /usr/bin/supersonic
